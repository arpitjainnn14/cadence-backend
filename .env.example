# Copy to .env for local dev. Never commit real secrets.
# Generate secrets: openssl rand -base64 48
# Generate VAPID keys (raw base64url): uv run vapid --gen  OR  npx web-push generate-vapid-keys

# SQLAlchemy URL (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/subs
# Signs access/refresh tokens; >=32 chars when COOKIE_SECURE=true
JWT_SECRET=replace-with-openssl-rand-base64-48
# Access token lifetime in minutes
ACCESS_TOKEN_MINUTES=15
# Refresh token lifetime in days
REFRESH_TOKEN_DAYS=30
# true in production (enforces strong secrets + VAPID); use false for local dev over http
COOKIE_SECURE=false
# Shared secret for the Cloud Scheduler endpoint; >=32 chars in production
SCHEDULER_SECRET=replace-with-openssl-rand-base64-48
# Web push VAPID public key (base64url)
VAPID_PUBLIC_KEY=
# Web push VAPID private key (base64url)
VAPID_PRIVATE_KEY=
# VAPID contact, mailto: or https://
VAPID_SUBJECT=mailto:you@example.com
# Default INR per 1 USD when no rate is set in the app
DEFAULT_USD_RATE=88
